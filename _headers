# Cloudflare Pages response headers (ignored by GitHub Pages and the local Node server).
# Build_intl/*.unityweb are Brotli files: declaring the encoding lets the browser decompress them natively
# and compile the wasm while it streams, instead of the Unity loader's slower JavaScript fallback.

/Build_intl/*.wasm.unityweb
  Content-Encoding: br
  Content-Type: application/wasm

/Build_intl/*.framework.js.unityweb
  Content-Encoding: br
  Content-Type: application/javascript

/Build_intl/*.data.unityweb
  Content-Encoding: br
  Content-Type: application/octet-stream

/Build_intl/*.symbols.json.unityweb
  Content-Encoding: br
  Content-Type: application/octet-stream
